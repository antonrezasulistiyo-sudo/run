# Strava: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# MapTiler (gratis): https://cloud.maptiler.com/account/keys/
NEXT_PUBLIC_MAPTILER_KEY=
# Domain utama aplikasi (tanpa slash di akhir), harus sama dengan Authorization Callback Domain di Strava
APP_URL=https://nama-project.vercel.app
# Opsional (mode relay): callback lengkap milik aplikasi lain yang domainnya terdaftar di Strava.
# STRAVA_REDIRECT_URI=https://marathon-pwa-omega.vercel.app/api/strava/callback
